<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ink.admin.mapper.AdminMapper">

    <!-- 结果映射 -->
    <resultMap id="BaseResultMap" type="com.ink.admin.entity.Admin">
        <id column="id" property="id"/>
        <result column="username" property="username"/>
        <result column="password" property="password"/>
        <result column="email" property="email"/>
        <result column="phone" property="phone"/>
        <result column="nickname" property="nickname"/>
        <result column="avatar" property="avatar"/>
        <result column="status" property="status"/>
        <result column="role" property="role"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
        <result column="last_login_time" property="lastLoginTime"/>
        <result column="last_login_ip" property="lastLoginIp"/>
    </resultMap>

    <!-- 基础列 -->
    <sql id="Base_Columns">
        id, username, password, email, phone, nickname, avatar, status, role,
        create_time, update_time, last_login_time, last_login_ip
    </sql>

    <!-- 根据用户名查询管理员 -->
    <select id="findByUsername" resultMap="BaseResultMap">
        SELECT <include refid="Base_Columns"/>
        FROM ink_admin_user
        WHERE username = #{username}
    </select>

    <!-- 根据邮箱查询管理员 -->
    <select id="findByEmail" resultMap="BaseResultMap">
        SELECT <include refid="Base_Columns"/>
        FROM ink_admin_user
        WHERE email = #{email}
    </select>

    <!-- 根据手机号查询管理员 -->
    <select id="findByPhone" resultMap="BaseResultMap">
        SELECT <include refid="Base_Columns"/>
        FROM ink_admin_user
        WHERE phone = #{phone}
    </select>

    <!-- 根据ID查询管理员 -->
    <select id="findById" resultMap="BaseResultMap">
        SELECT <include refid="Base_Columns"/>
        FROM ink_admin_user
        WHERE id = #{id}
    </select>

    <!-- 查询所有管理员 -->
    <select id="findAll" resultMap="BaseResultMap">
        SELECT <include refid="Base_Columns"/>
        FROM ink_admin_user
        ORDER BY create_time DESC
    </select>

    <!-- 分页查询管理员 -->
    <select id="findByPage" resultMap="BaseResultMap">
        SELECT <include refid="Base_Columns"/>
        FROM ink_admin_user
        ORDER BY create_time DESC
        LIMIT #{offset}, #{limit}
    </select>

    <!-- 查询管理员总数 -->
    <select id="count" resultType="int">
        SELECT COUNT(*) FROM ink_admin_user
    </select>

    <!-- 插入管理员 -->
    <insert id="insert" parameterType="com.ink.admin.entity.Admin" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO ink_admin_user (
            username, password, email, phone, nickname, avatar, status, role,
            create_time, update_time
        ) VALUES (
            #{username}, #{password}, #{email}, #{phone}, #{nickname}, #{avatar}, #{status}, #{role},
            #{createTime}, #{updateTime}
        )
    </insert>

    <!-- 更新管理员 -->
    <update id="update" parameterType="com.ink.admin.entity.Admin">
        UPDATE ink_admin_user
        SET 
            username = #{username},
            email = #{email},
            phone = #{phone},
            nickname = #{nickname},
            avatar = #{avatar},
            status = #{status},
            role = #{role},
            update_time = #{updateTime}
        <if test="password != null and password != ''">
            , password = #{password}
        </if>
        WHERE id = #{id}
    </update>

    <!-- 删除管理员 -->
    <delete id="deleteById">
        DELETE FROM ink_admin_user WHERE id = #{id}
    </delete>

    <!-- 更新管理员状态 -->
    <update id="updateStatus">
        UPDATE ink_admin_user
        SET status = #{status}, update_time = NOW()
        WHERE id = #{id}
    </update>

    <!-- 更新最后登录时间 -->
    <update id="updateLastLoginTime">
        UPDATE ink_admin_user
        SET last_login_time = #{lastLoginTime}, last_login_ip = #{lastLoginIp}, update_time = NOW()
        WHERE id = #{id}
    </update>

    <!-- 检查用户名是否存在 -->
    <select id="existsByUsername" resultType="boolean">
        SELECT COUNT(*) > 0 FROM ink_admin_user WHERE username = #{username}
    </select>

    <!-- 检查邮箱是否存在 -->
    <select id="existsByEmail" resultType="boolean">
        SELECT COUNT(*) > 0 FROM ink_admin_user WHERE email = #{email}
    </select>

    <!-- 检查手机号是否存在 -->
    <select id="existsByPhone" resultType="boolean">
        SELECT COUNT(*) > 0 FROM ink_admin_user WHERE phone = #{phone}
    </select>

</mapper>
