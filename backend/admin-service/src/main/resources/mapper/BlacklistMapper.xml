<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ink.admin.mapper.BlacklistMapper">

    <!-- 结果映射 -->
    <resultMap id="BaseResultMap" type="com.ink.admin.entity.Blacklist">
        <id column="id" property="id"/>
        <result column="channel_code" property="channelCode"/>
        <result column="phone" property="phone"/>
        <result column="keyword" property="keyword"/>
        <result column="source_mo_id" property="sourceMoId"/>
        <result column="expire_time" property="expireTime"/>
        <result column="create_time" property="createTime"/>
    </resultMap>

    <!-- 基础列 -->
    <sql id="Base_Columns">
        id, channel_code, phone, keyword, source_mo_id, expire_time, create_time
    </sql>

    <!-- 根据ID查询 -->
    <select id="findById" resultMap="BaseResultMap">
        SELECT <include refid="Base_Columns"/>
        FROM ink_blacklist WHERE id = #{id}
    </select>

    <!-- 分页查询（支持通道/手机号过滤） -->
    <select id="findByPage" resultMap="BaseResultMap">
        SELECT <include refid="Base_Columns"/>
        FROM ink_blacklist
        <where>
            <if test="channelCode != null and channelCode != ''">
                AND channel_code = #{channelCode}
            </if>
            <if test="phone != null and phone != ''">
                AND phone LIKE CONCAT('%', #{phone}, '%')
            </if>
        </where>
        ORDER BY create_time DESC
        LIMIT #{offset}, #{limit}
    </select>

    <!-- 总数（支持通道/手机号过滤） -->
    <select id="count" resultType="int">
        SELECT COUNT(*) FROM ink_blacklist
        <where>
            <if test="channelCode != null and channelCode != ''">
                AND channel_code = #{channelCode}
            </if>
            <if test="phone != null and phone != ''">
                AND phone LIKE CONCAT('%', #{phone}, '%')
            </if>
        </where>
    </select>

    <!-- 删除 -->
    <delete id="deleteById">
        DELETE FROM ink_blacklist WHERE id = #{id}
    </delete>

</mapper>
